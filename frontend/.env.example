# 真值在 /opt/sml/ryojaku-secrets/ext_frontend_frontend_.env（遷移時進 SSM）
#
# ⚠️ VITE_API_BASE_URL / VITE_WS_BASE_URL 皆為 fail-closed:沒設就報錯/拒連。
#    它們原本預設回退到工程師的「正式」環境(yg7y0xkb50 / ek5dythoh9 寫死),
#    等於 staging build 會安靜地打到 13k 真實用戶的資料上,故移除預設值。
# ⚠️ 一律用自訂網域,不要填 *.execute-api.* 原始位址 —— App 把它烘進 binary,
#    API Gateway 一旦重建(換帳號/換 region/IaC 重跑)ID 就變,已安裝的 App 會同時變磚。
#    自訂網域的 base path 掛在根,所以結尾「沒有」/stg。
# staging REST: https://ryojaku-api.boyplaymj.com
VITE_API_BASE_URL=
# staging WS:   wss://ryojaku-ws.boyplaymj.com
VITE_WS_BASE_URL=
VITE_GEMINI_API_KEY=

# 分享連結用的公開網域(https://網域,不帶路徑)。只有原生 App 會用到:
# 殼裡的 window.location.origin 是 https://localhost,不設這一項分享出去的連結打不開。
# ⚠️ 烘進 binary 之後改不了。staging: https://ryojaku-stg.boyplaymj.com
VITE_PUBLIC_WEB_ORIGIN=

# 帳號系統 P5: Google 登入 client_id(Google Cloud OAuth 2.0 Web client)
VITE_GOOGLE_CLIENT_ID=
