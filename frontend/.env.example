# 真值在 /opt/sml/ryojaku-secrets/ext_frontend_frontend_.env（遷移時進 SSM）
#
# ⚠️ VITE_API_BASE_URL / VITE_WS_BASE_URL 皆為 fail-closed:沒設就報錯/拒連。
#    它們原本預設回退到工程師的「正式」環境(yg7y0xkb50 / ek5dythoh9 寫死),
#    等於 staging build 會安靜地打到 13k 真實用戶的資料上,故移除預設值。
# staging REST: https://9mu0vajn38.execute-api.ap-southeast-1.amazonaws.com/stg
VITE_API_BASE_URL=
# staging WS:   wss://xb0exhv770.execute-api.ap-southeast-1.amazonaws.com/stg
VITE_WS_BASE_URL=
VITE_GEMINI_API_KEY=

# 帳號系統 P5: Google 登入 client_id(Google Cloud OAuth 2.0 Web client)
VITE_GOOGLE_CLIENT_ID=
