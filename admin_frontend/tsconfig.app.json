{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    // 🔴 加 "node" 是為了 src/utils/*.test.ts（node:test／node:assert）能被型別檢查。
    //    不加的話那兩個 import 是 TS2307，而「測試檔沒被 typecheck」與
    //    「typecheck 全過」在 rc 上會被逼成同一個 —— 只能靠把測試排除掉來換綠，
    //    那等於把唯一會檢查它的東西關掉。
    //    ⚠️ 代價：node 的全域型別（process／Buffer）在瀏覽器程式碼裡也會通過檢查。
    //    同 repo 的 frontend/tsconfig.json 早就是這個取捨，這裡跟它一致。
    "types": [
      "vite/client",
      "node"
    ],
    "skipLibCheck": true,
    // 🔴 引擎副本（src/engine/mahjong-tai/）是 .js/.mjs＋一份 .json。
    //    allowJs 讓 .ts 那側 import 得到它們（沒有 .d.ts，也刻意不寫一份 ——
    //    手寫的型別會與正典的實作各自漂，而漂了不會有東西轉紅）。
    //    checkJs 刻意**不開**：那會拿 TS 的規則去挑正典的 JS，
    //    而正典不歸這個專案改。同 repo 的 frontend/tsconfig.json 也是 allowJs 開、checkJs 關。
    "allowJs": true,
    "resolveJsonModule": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}